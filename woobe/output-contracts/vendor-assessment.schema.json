{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasVendorAssessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {"type": "string"},
    "overall_risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "recommendation": {"type": "string", "enum": ["APPROVE", "APPROVE_WITH_CONDITIONS", "MANUAL_REVIEW", "REJECT"]},
    "domain_scores": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SECURITY": {"type": "integer", "minimum": 0, "maximum": 100},
        "LEGAL": {"type": "integer", "minimum": 0, "maximum": 100},
        "COMPLIANCE": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "executive_summary": {"type": "string"}
  },
  "required": ["assessment_id", "overall_risk_score", "recommendation", "domain_scores", "findings", "unknowns", "executive_summary"],
  "$defs": {
    "evidence": {"type":"object","additionalProperties":false,"properties":{"evidence_id":{"type":"string"},"document_id":{"type":"string"},"document_name":{"type":"string"},"page_number":{"type":["integer","null"]},"quote":{"type":"string"}},"required":["evidence_id","document_id","document_name","page_number","quote"]},
    "finding": {"type":"object","additionalProperties":false,"properties":{"requirement_code":{"type":"string"},"severity":{"type":"string","enum":["CRITICAL","HIGH","MEDIUM","LOW","INFO"]},"title":{"type":"string"},"summary":{"type":"string"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/evidence"}}},"required":["requirement_code","severity","title","summary","evidence_refs"]}
  }
}
