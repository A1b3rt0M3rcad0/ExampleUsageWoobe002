{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AtlasSecurityAssessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {"type": "string"},
    "domain": {"type": "string", "const": "SECURITY"},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["assessment_id", "domain", "risk_score", "requirements", "findings", "unknowns"],
  "$defs": {
    "evidence": {"type":"object","additionalProperties":false,"properties":{"evidence_id":{"type":"string"},"document_id":{"type":"string"},"document_name":{"type":"string"},"page_number":{"type":["integer","null"]},"quote":{"type":"string"}},"required":["evidence_id","document_id","document_name","page_number","quote"]},
    "requirement": {"type":"object","additionalProperties":false,"properties":{"requirement_code":{"type":"string"},"status":{"type":"string","enum":["PASS","FAIL","NOT_EVIDENCED","NOT_APPLICABLE"]},"severity":{"type":"string","enum":["CRITICAL","HIGH","MEDIUM","LOW","INFO"]},"summary":{"type":"string"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/evidence"}}},"required":["requirement_code","status","severity","summary","evidence_refs"]},
    "finding": {"type":"object","additionalProperties":false,"properties":{"requirement_code":{"type":"string"},"severity":{"type":"string","enum":["CRITICAL","HIGH","MEDIUM","LOW","INFO"]},"title":{"type":"string"},"summary":{"type":"string"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/evidence"}}},"required":["requirement_code","severity","title","summary","evidence_refs"]}
  }
}
