ATLAS_ENV=development
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8080
ATLAS_DATABASE_PATH=./data/atlas.db
ATLAS_STORAGE_PATH=./data/uploads
ATLAS_MAX_UPLOAD_MB=20

# Shared secret used only for Woobe -> Atlas HTTP Tool calls.
# Generate a random secret and use the same raw token in Atlas.
ATLAS_WOOBE_TOOL_TOKEN=replace-me-with-a-random-token

# Woobe Runtime API. The Runtime Key must be bound to the Atlas Network
# in STAGING or PRODUCTION. Runtime Keys do not execute Draft.
WOOBE_BASE_URL=http://localhost:8000
WOOBE_RUNTIME_KEY=replace-me-with-network-runtime-key
WOOBE_TIMEOUT_SECONDS=180
